CLASS zcl_mm_query_invent DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
    INTERFACES if_rap_query_provider.
  PROTECTED SECTION.
  PRIVATE SECTION.
    METHODS get_filter_low
      IMPORTING it_pairs      TYPE if_rap_query_filter=>tt_name_range_pairs
                iv_name       TYPE string
      RETURNING VALUE(rv_low) TYPE string.
ENDCLASS.



CLASS zcl_mm_query_invent IMPLEMENTATION.

  METHOD get_filter_low.
    rv_low = VALUE #( it_pairs[ name = iv_name ]-range[ 1 ]-low DEFAULT '' ).
  ENDMETHOD.

  METHOD if_rap_query_provider~select.

    DATA: lt_result TYPE STANDARD TABLE OF zi_mm_invent_closing_ship.

    FIELD-SYMBOLS: <fs_result> TYPE zi_mm_invent_closing_ship.

    TRY.

        TRY.
            DATA(lt_pairs) = io_request->get_filter( )->get_as_ranges( ).
          CATCH cx_rap_query_filter_no_range INTO DATA(lx_filter).
        ENDTRY.

        DATA(lv_fiscalyear) = CONV gjahr( get_filter_low( it_pairs = lt_pairs iv_name = 'FISCALYEAR' ) ).
        DATA(lv_plant)      = CONV werks_d( get_filter_low( it_pairs = lt_pairs iv_name = 'PLANT' ) ).
        DATA(lv_companycode) = CONV bukrs( get_filter_low( it_pairs = lt_pairs iv_name = 'COMPANYCODE' ) ).
        DATA(lv_inventorydocument) = CONV iblnr( get_filter_low( it_pairs = lt_pairs iv_name = 'INVENTORYDOCUMENT' ) ).

        DATA lt_delta TYPE STANDARD TABLE OF zi_inv_delta_contabi.
        DATA lt_zdoc  TYPE STANDARD TABLE OF zinv_documentos.

        IF lv_plant IS NOT INITIAL.

          SELECT *
            FROM zi_inv_delta_contabi
            WHERE fiscalyear = @lv_fiscalyear
              AND plant      = @lv_plant
            INTO TABLE @lt_delta.

          SELECT *
            FROM zinv_documentos
            WHERE gjahr = @lv_fiscalyear
              AND werks = @lv_plant
            INTO TABLE @lt_zdoc.

        ELSEIF lv_inventorydocument IS NOT INITIAL.

          SELECT *
            FROM zi_inv_delta_contabi
            WHERE bukrs             = @lv_companycode
              AND inventorydocument = @lv_inventorydocument
              AND fiscalyear        = @lv_fiscalyear
            INTO TABLE @lt_delta.

          SELECT *
            FROM zinv_documentos
            WHERE bukrs = @lv_companycode
              AND iblnr = @lv_inventorydocument
              AND gjahr = @lv_fiscalyear
            INTO TABLE @lt_zdoc.

        ENDIF.

        TYPES: BEGIN OF ty_doc_flag,
                 bukrs      TYPE bukrs,
                 iblnr      TYPE iblnr,
                 gjahr      TYPE gjahr,
                 has_cancel TYPE abap_bool,
                 has_error  TYPE abap_bool,
                 has_final  TYPE abap_bool,
                 has_open   TYPE abap_bool,
                 z_count    TYPE i,
               END OF ty_doc_flag.

        DATA lt_flag TYPE HASHED TABLE OF ty_doc_flag
          WITH UNIQUE KEY bukrs iblnr gjahr.
        DATA lt_z_header TYPE HASHED TABLE OF zinv_documentos
          WITH UNIQUE KEY bukrs iblnr gjahr.

        LOOP AT lt_zdoc INTO DATA(ls_zdoc).
          DATA(lv_status_up) = to_upper( ls_zdoc-status ).

          READ TABLE lt_flag ASSIGNING FIELD-SYMBOL(<fs_flag>)
            WITH TABLE KEY bukrs = ls_zdoc-bukrs
                           iblnr = ls_zdoc-iblnr
                           gjahr = ls_zdoc-gjahr.
          IF sy-subrc <> 0.
            INSERT VALUE #(
              bukrs = ls_zdoc-bukrs
              iblnr = ls_zdoc-iblnr
              gjahr = ls_zdoc-gjahr
            ) INTO TABLE lt_flag.
            READ TABLE lt_flag ASSIGNING <fs_flag>
              WITH TABLE KEY bukrs = ls_zdoc-bukrs
                             iblnr = ls_zdoc-iblnr
                             gjahr = ls_zdoc-gjahr.
          ENDIF.
          <fs_flag>-z_count = <fs_flag>-z_count + 1.
          IF lv_status_up = 'CONTADO_EN'.
            <fs_flag>-has_final = abap_true.
          ELSEIF lv_status_up = 'CONTADO_ER' OR lv_status_up = 'ENVIADO_ER'.
            <fs_flag>-has_error = abap_true.
          ELSEIF lv_status_up = 'CANCELADO' OR lv_status_up = 'CANCEL_ENV' OR lv_status_up = 'CANCEL_ERR'.
            <fs_flag>-has_cancel = abap_true.
          ELSE.
            <fs_flag>-has_open = abap_true.
          ENDIF.

          READ TABLE lt_z_header ASSIGNING FIELD-SYMBOL(<fs_z_header>)
            WITH TABLE KEY bukrs = ls_zdoc-bukrs
                           iblnr = ls_zdoc-iblnr
                           gjahr = ls_zdoc-gjahr.
          IF sy-subrc <> 0.
            INSERT ls_zdoc INTO TABLE lt_z_header.
          ELSEIF lv_status_up = 'CONTADO_ER' OR lv_status_up = 'ENVIADO_ER'.
            <fs_z_header> = ls_zdoc.
          ENDIF.
        ENDLOOP.

        TYPES: BEGIN OF ty_seen,
                 bukrs TYPE bukrs,
                 iblnr TYPE iblnr,
                 gjahr TYPE gjahr,
               END OF ty_seen.
        DATA lt_seen TYPE HASHED TABLE OF ty_seen
          WITH UNIQUE KEY bukrs iblnr gjahr.

        LOOP AT lt_delta INTO DATA(ls_delta).
          READ TABLE lt_seen TRANSPORTING NO FIELDS
            WITH TABLE KEY bukrs = ls_delta-bukrs
                           iblnr = ls_delta-inventorydocument
                           gjahr = ls_delta-fiscalyear.
          IF sy-subrc = 0.
            CONTINUE.
          ENDIF.
          INSERT VALUE #(
            bukrs = ls_delta-bukrs
            iblnr = ls_delta-inventorydocument
            gjahr = ls_delta-fiscalyear
          ) INTO TABLE lt_seen.

          DATA ls_flag TYPE ty_doc_flag.
          READ TABLE lt_flag INTO ls_flag
            WITH TABLE KEY bukrs = ls_delta-bukrs
                           iblnr = ls_delta-inventorydocument
                           gjahr = ls_delta-fiscalyear.
          IF sy-subrc = 0.
            IF ls_flag-has_cancel = abap_true.
              CONTINUE.
            ENDIF.
            IF ls_flag-z_count > 0
               AND ls_flag-has_final = abap_true
               AND ls_flag-has_error = abap_false
               AND ls_flag-has_open = abap_false.
              CONTINUE.
            ENDIF.
          ELSE.
            CLEAR ls_flag.
          ENDIF.

          APPEND INITIAL LINE TO lt_result ASSIGNING <fs_result>.
          <fs_result>-CompanyCode       = ls_delta-bukrs.
          <fs_result>-InventoryDocument = ls_delta-inventorydocument.
          <fs_result>-FiscalYear        = ls_delta-fiscalyear.
          <fs_result>-Plant             = ls_delta-plant.
          <fs_result>-Almacen           = ls_delta-almacen.
          <fs_result>-DocumentDate      = ls_delta-documentdate.
          <fs_result>-SyncStatusCode    = 'CONTADO'.
          <fs_result>-Nameupd           = ls_delta-nameupd.
          <fs_result>-LastSyncAt        = ls_delta-lastsyncat.
          <fs_result>-DeltaId           = ls_delta-deltaid.
          <fs_result>-ErrorMessage      = ls_delta-errormessage.
          <fs_result>-DocumentDateConta = ls_delta-documentdateconta.

          READ TABLE lt_z_header INTO DATA(ls_z_header)
            WITH TABLE KEY bukrs = ls_delta-bukrs
                           iblnr = ls_delta-inventorydocument
                           gjahr = ls_delta-fiscalyear.
          IF sy-subrc = 0.
            <fs_result>-Nameupd      = ls_z_header-last_sync_by.
            <fs_result>-LastSyncAt   = ls_z_header-last_sync_at.
            <fs_result>-DeltaId      = ls_z_header-delta_id.
            <fs_result>-ErrorMessage = ls_z_header-error_message.
            <fs_result>-SyncStatusCode = to_upper( ls_z_header-status ).
            IF ls_z_header-budat IS NOT INITIAL.
              <fs_result>-DocumentDateConta = ls_z_header-budat.
            ENDIF.
          ENDIF.
        ENDLOOP.

        SORT lt_result BY companycode ASCENDING
                          inventorydocument ASCENDING
                          fiscalyear ASCENDING
                          lastsyncat DESCENDING.
        DELETE ADJACENT DUPLICATES FROM lt_result
          COMPARING companycode inventorydocument fiscalyear.

        DATA: lt_page LIKE lt_result.

        IF io_request->is_total_numb_of_rec_requested( ).
          io_response->set_total_number_of_records( CONV int8( lines( lt_result ) ) ).
        ENDIF.

        DATA(lo_paging)    = io_request->get_paging( ).
        DATA(lv_offset)    = lo_paging->get_offset( ).
        DATA(lv_page_size) = lo_paging->get_page_size( ).

        IF lv_offset > 0 OR lv_page_size <> if_rap_query_paging=>page_size_unlimited.

          LOOP AT lt_result INTO DATA(ls_page) FROM lv_offset + 1.
            APPEND ls_page TO lt_page.
            IF lv_page_size <> if_rap_query_paging=>page_size_unlimited
               AND lines( lt_page ) >= lv_page_size.
              EXIT.
            ENDIF.
          ENDLOOP.
          lt_result = lt_page.
        ENDIF.

        io_response->set_data( lt_result ).

      CATCH zcx_mm_pullactive_exception INTO DATA(lx_error).
        IF io_request->is_data_requested( ).
          io_response->set_data( lt_result ).
        ENDIF.

        IF io_request->is_total_numb_of_rec_requested( ).
          io_response->set_total_number_of_records( 0 ).
        ENDIF.

    ENDTRY.

  ENDMETHOD.
ENDCLASS.
