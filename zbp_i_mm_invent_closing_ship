CLASS lcl_buffer DEFINITION CREATE PRIVATE.
  PUBLIC SECTION.
    CLASS-DATA: gt_zinv_update TYPE TABLE OF zinv_documentos WITH DEFAULT KEY.
ENDCLASS.

CLASS lhc_ZI_MM_INVENT_CLOSING_SHIP DEFINITION INHERITING FROM cl_abap_behavior_handler.
  PRIVATE SECTION.

    METHODS get_instance_authorizations FOR INSTANCE AUTHORIZATION
      IMPORTING keys REQUEST requested_authorizations FOR zi_mm_invent_closing_ship RESULT result.

    METHODS read FOR READ
      IMPORTING keys FOR READ zi_mm_invent_closing_ship RESULT result.

    METHODS lock FOR LOCK
      IMPORTING keys FOR LOCK zi_mm_invent_closing_ship.

    METHODS sendcpi FOR MODIFY
      IMPORTING keys FOR ACTION zi_mm_invent_closing_ship~sendcpi.

    METHODS rba_Item FOR READ
      IMPORTING keys_rba FOR READ zi_mm_invent_closing_ship\_Item FULL result_requested RESULT result LINK association_links.

ENDCLASS.

CLASS lhc_ZI_MM_INVENT_CLOSING_SHIP IMPLEMENTATION.

  METHOD get_instance_authorizations.
  ENDMETHOD.

  METHOD read.
    FIELD-SYMBOLS: <fs_result> TYPE STRUCTURE FOR READ RESULT zi_mm_invent_closing_ship.

    IF keys IS INITIAL.
      RETURN.
    ENDIF.

    TYPES: BEGIN OF ty_doc_flag,
             bukrs      TYPE bukrs,
             iblnr      TYPE iblnr,
             gjahr      TYPE gjahr,
             has_cancel TYPE abap_bool,
             has_error  TYPE abap_bool,
             has_final  TYPE abap_bool,
             has_open   TYPE abap_bool,
             z_count    TYPE i,
           END OF ty_doc_flag.

    DATA lt_zinv_documentos TYPE STANDARD TABLE OF zinv_documentos.
    DATA lt_zinv_header TYPE HASHED TABLE OF zinv_documentos
      WITH UNIQUE KEY bukrs iblnr gjahr.
    DATA lt_delta TYPE STANDARD TABLE OF zi_inv_delta_contabi.
    DATA lt_delta_header TYPE HASHED TABLE OF zi_inv_delta_contabi
      WITH UNIQUE KEY bukrs inventorydocument fiscalyear.
    DATA lt_flag TYPE HASHED TABLE OF ty_doc_flag
      WITH UNIQUE KEY bukrs iblnr gjahr.

    SELECT *
      FROM zinv_documentos
      FOR ALL ENTRIES IN @keys
      WHERE bukrs = @keys-CompanyCode
        AND iblnr = @keys-InventoryDocument
        AND gjahr = @keys-FiscalYear
      INTO TABLE @lt_zinv_documentos.

    SELECT *
      FROM zi_inv_delta_contabi
      FOR ALL ENTRIES IN @keys
      WHERE bukrs             = @keys-CompanyCode
        AND inventorydocument = @keys-InventoryDocument
        AND fiscalyear        = @keys-FiscalYear
      INTO TABLE @lt_delta.

    LOOP AT lt_zinv_documentos INTO DATA(ls_z).
      DATA(lv_status_up) = to_upper( ls_z-status ).

      READ TABLE lt_flag ASSIGNING FIELD-SYMBOL(<fs_flag>)
        WITH TABLE KEY bukrs = ls_z-bukrs
                       iblnr = ls_z-iblnr
                       gjahr = ls_z-gjahr.
      IF sy-subrc <> 0.
        INSERT VALUE #(
          bukrs = ls_z-bukrs
          iblnr = ls_z-iblnr
          gjahr = ls_z-gjahr
        ) INTO TABLE lt_flag.
        READ TABLE lt_flag ASSIGNING <fs_flag>
          WITH TABLE KEY bukrs = ls_z-bukrs
                         iblnr = ls_z-iblnr
                         gjahr = ls_z-gjahr.
      ENDIF.
      <fs_flag>-z_count = <fs_flag>-z_count + 1.
      IF lv_status_up = 'CONTADO_EN'.
        <fs_flag>-has_final = abap_true.
      ELSEIF lv_status_up = 'CONTADO_ER' OR lv_status_up = 'ENVIADO_ER'.
        <fs_flag>-has_error = abap_true.
      ELSEIF lv_status_up = 'CANCELADO' OR lv_status_up = 'CANCEL_ENV' OR lv_status_up = 'CANCEL_ERR'.
        <fs_flag>-has_cancel = abap_true.
      ELSE.
        <fs_flag>-has_open = abap_true.
      ENDIF.

      READ TABLE lt_zinv_header ASSIGNING FIELD-SYMBOL(<fs_header>)
        WITH TABLE KEY bukrs = ls_z-bukrs
                       iblnr = ls_z-iblnr
                       gjahr = ls_z-gjahr.
      IF sy-subrc <> 0.
        INSERT ls_z INTO TABLE lt_zinv_header.
      ELSEIF lv_status_up = 'CONTADO_ER' OR lv_status_up = 'ENVIADO_ER'.
        <fs_header> = ls_z.
      ENDIF.
    ENDLOOP.

    LOOP AT lt_delta INTO DATA(ls_delta).
      READ TABLE lt_delta_header TRANSPORTING NO FIELDS
        WITH TABLE KEY bukrs             = ls_delta-bukrs
                       inventorydocument = ls_delta-inventorydocument
                       fiscalyear        = ls_delta-fiscalyear.
      IF sy-subrc <> 0.
        INSERT ls_delta INTO TABLE lt_delta_header.
      ENDIF.
    ENDLOOP.

    LOOP AT keys INTO DATA(ls_key).
      READ TABLE lt_delta_header INTO DATA(ls_d)
        WITH TABLE KEY bukrs             = ls_key-CompanyCode
                       inventorydocument = ls_key-InventoryDocument
                       fiscalyear        = ls_key-FiscalYear.
      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.

      DATA ls_flag TYPE ty_doc_flag.
      READ TABLE lt_flag INTO ls_flag
        WITH TABLE KEY bukrs = ls_key-CompanyCode
                       iblnr = ls_key-InventoryDocument
                       gjahr = ls_key-FiscalYear.
      IF sy-subrc = 0.
        IF ls_flag-has_cancel = abap_true.
          CONTINUE.
        ENDIF.
        IF ls_flag-z_count > 0
           AND ls_flag-has_final = abap_true
           AND ls_flag-has_error = abap_false
           AND ls_flag-has_open = abap_false.
          CONTINUE.
        ENDIF.
      ELSE.
        CLEAR ls_flag.
      ENDIF.

      APPEND INITIAL LINE TO result ASSIGNING <fs_result>.
      <fs_result>-CompanyCode       = ls_key-CompanyCode.
      <fs_result>-InventoryDocument = ls_key-InventoryDocument.
      <fs_result>-FiscalYear        = ls_key-FiscalYear.
      <fs_result>-Plant             = ls_d-plant.
      <fs_result>-Almacen           = ls_d-almacen.
      <fs_result>-DocumentDate      = ls_d-documentdate.
      <fs_result>-SyncStatusCode    = 'CONTADO'.
      <fs_result>-Nameupd           = ls_d-nameupd.
      <fs_result>-LastSyncAt        = ls_d-lastsyncat.
      <fs_result>-DeltaId           = ls_d-deltaid.
      <fs_result>-ErrorMessage      = ls_d-errormessage.
      <fs_result>-DocumentDateConta = ls_d-documentdateconta.

      READ TABLE lt_zinv_header INTO DATA(ls_header)
        WITH TABLE KEY bukrs = ls_key-CompanyCode
                       iblnr = ls_key-InventoryDocument
                       gjahr = ls_key-FiscalYear.
      IF sy-subrc = 0.
        <fs_result>-Nameupd      = ls_header-last_sync_by.
        <fs_result>-LastSyncAt   = ls_header-last_sync_at.
        <fs_result>-DeltaId      = ls_header-delta_id.
        <fs_result>-ErrorMessage = ls_header-error_message.
        <fs_result>-SyncStatusCode = to_upper( ls_header-status ).
        IF ls_header-budat IS NOT INITIAL.
          <fs_result>-DocumentDateConta = ls_header-budat.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD lock.
  ENDMETHOD.

  METHOD sendcpi.
    DATA: gr_handler TYPE REF TO zcl_inv_clo_cpi,
          lt_data    TYPE zcl_inv_clo_cpi=>tt_inventory_alv.

    TYPES: BEGIN OF ty_doc_msg,
             companycode       TYPE bukrs,
             inventorydocument TYPE iblnr,
             fiscalyear        TYPE gjahr,
             success           TYPE abap_bool,
             message           TYPE string,
           END OF ty_doc_msg.

    DATA lt_doc_msg TYPE HASHED TABLE OF ty_doc_msg
      WITH UNIQUE KEY companycode inventorydocument fiscalyear.

    TYPES ty_action_key LIKE LINE OF keys.
    DATA lt_action_keys TYPE HASHED TABLE OF ty_action_key
      WITH UNIQUE KEY companycode inventorydocument fiscalyear.

    IF keys IS INITIAL.
      RETURN.
    ENDIF.

    INSERT LINES OF keys INTO TABLE lt_action_keys.

    TYPES: BEGIN OF ty_doc_flag,
             bukrs      TYPE bukrs,
             iblnr      TYPE iblnr,
             gjahr      TYPE gjahr,
             has_cancel TYPE abap_bool,
             has_error  TYPE abap_bool,
             has_final  TYPE abap_bool,
             has_open   TYPE abap_bool,
             z_count    TYPE i,
           END OF ty_doc_flag.

    DATA lt_zinv TYPE STANDARD TABLE OF zinv_documentos.
    DATA lt_z_idx TYPE HASHED TABLE OF zinv_documentos
      WITH UNIQUE KEY bukrs iblnr zeile gjahr.
    DATA lt_delta TYPE STANDARD TABLE OF zi_inv_delta_contabi.
    DATA lt_flag TYPE HASHED TABLE OF ty_doc_flag
      WITH UNIQUE KEY bukrs iblnr gjahr.

    SELECT *
      FROM zinv_documentos
      FOR ALL ENTRIES IN @keys
      WHERE bukrs = @keys-CompanyCode
        AND iblnr = @keys-InventoryDocument
        AND gjahr = @keys-FiscalYear
      INTO TABLE @lt_zinv.

    SELECT *
      FROM zi_inv_delta_contabi
      FOR ALL ENTRIES IN @keys
      WHERE bukrs             = @keys-CompanyCode
        AND inventorydocument = @keys-InventoryDocument
        AND fiscalyear        = @keys-FiscalYear
      INTO TABLE @lt_delta.

    LOOP AT lt_zinv INTO DATA(ls_zflag).
      DATA(lv_status_up) = to_upper( ls_zflag-status ).
      READ TABLE lt_flag ASSIGNING FIELD-SYMBOL(<fs_flag>)
        WITH TABLE KEY bukrs = ls_zflag-bukrs
                       iblnr = ls_zflag-iblnr
                       gjahr = ls_zflag-gjahr.
      IF sy-subrc <> 0.
        INSERT VALUE #(
          bukrs = ls_zflag-bukrs
          iblnr = ls_zflag-iblnr
          gjahr = ls_zflag-gjahr
        ) INTO TABLE lt_flag.
        READ TABLE lt_flag ASSIGNING <fs_flag>
          WITH TABLE KEY bukrs = ls_zflag-bukrs
                         iblnr = ls_zflag-iblnr
                         gjahr = ls_zflag-gjahr.
      ENDIF.
      <fs_flag>-z_count = <fs_flag>-z_count + 1.
      IF lv_status_up = 'CONTADO_EN'.
        <fs_flag>-has_final = abap_true.
      ELSEIF lv_status_up = 'CONTADO_ER' OR lv_status_up = 'ENVIADO_ER'.
        <fs_flag>-has_error = abap_true.
      ELSEIF lv_status_up = 'CANCELADO' OR lv_status_up = 'CANCEL_ENV' OR lv_status_up = 'CANCEL_ERR'.
        <fs_flag>-has_cancel = abap_true.
      ELSE.
        <fs_flag>-has_open = abap_true.
      ENDIF.
    ENDLOOP.

    INSERT LINES OF lt_zinv INTO TABLE lt_z_idx.

    LOOP AT lt_delta INTO DATA(ls_d).
      DATA ls_flag TYPE ty_doc_flag.
      READ TABLE lt_flag INTO ls_flag
        WITH TABLE KEY bukrs = ls_d-bukrs
                       iblnr = ls_d-inventorydocument
                       gjahr = ls_d-fiscalyear.
      IF sy-subrc = 0.
        IF ls_flag-has_cancel = abap_true.
          CONTINUE.
        ENDIF.
        IF ls_flag-z_count > 0
           AND ls_flag-has_final = abap_true
           AND ls_flag-has_error = abap_false
           AND ls_flag-has_open = abap_false.
          CONTINUE.
        ENDIF.
      ENDIF.

      READ TABLE lt_z_idx INTO DATA(ls_z)
        WITH TABLE KEY bukrs = ls_d-bukrs
                       iblnr = ls_d-inventorydocument
                       zeile = ls_d-inventorydocumentitem
                       gjahr = ls_d-fiscalyear.
      IF sy-subrc = 0.
        DATA(lv_item_status) = to_upper( ls_z-status ).
        IF lv_item_status = 'CONTADO_EN'
           OR lv_item_status = 'CANCELADO'
           OR lv_item_status = 'CANCEL_ENV'
           OR lv_item_status = 'CANCEL_ERR'.
          CONTINUE.
        ENDIF.
        APPEND VALUE #(
          bukrs             = ls_z-bukrs
          inventorydocument = ls_z-iblnr
          fiscalyear        = ls_z-gjahr
          plant             = ls_z-werks
          almacen           = ls_z-lgort
          material          = ls_z-matnr
          item              = ls_z-zeile
          documentdate      = ls_z-bldat
          quantity          = ls_z-erfmg
          quantityzero      = ls_z-xnull
          baseunitofmeasure = ls_z-meins
          syncstatuscode    = to_upper( ls_z-status )
          nameupd           = ls_z-last_sync_by
          lastsyncat        = ls_z-last_sync_at
          deltaid           = ls_z-delta_id
          menerror          = ls_z-error_message
          documentdateconta = ls_z-budat
        ) TO lt_data.
      ELSE.
        APPEND VALUE #(
          bukrs             = ls_d-bukrs
          inventorydocument = ls_d-inventorydocument
          fiscalyear        = ls_d-fiscalyear
          plant             = ls_d-plant
          almacen           = ls_d-almacen
          material          = ls_d-material
          item              = ls_d-inventorydocumentitem
          documentdate      = ls_d-documentdate
          quantity          = ls_d-quantity
          quantityzero      = ls_d-quantityzero
          baseunitofmeasure = ls_d-baseunitofmeasure
          syncstatuscode    = 'CONTADO'
          nameupd           = ls_d-nameupd
          lastsyncat        = ls_d-lastsyncat
          deltaid           = ls_d-deltaid
          menerror          = ls_d-errormessage
          documentdateconta = ls_d-documentdateconta
        ) TO lt_data.
      ENDIF.
    ENDLOOP.

    IF lt_data IS INITIAL.
      LOOP AT keys INTO DATA(ls_key_empty).
        reported-zi_mm_invent_closing_ship = VALUE #( BASE reported-zi_mm_invent_closing_ship (
          %tky = ls_key_empty-%tky
          %msg = new_message_with_text(
                   severity = if_abap_behv_message=>severity-error
                   text     = 'No hay posiciones para el documento de inventario.' ) ) ).
      ENDLOOP.
      RETURN.
    ENDIF.

    CREATE OBJECT gr_handler.

    gr_handler->send_data_to_cpi(
      IMPORTING
        t_zinv_update    = lcl_buffer=>gt_zinv_update
        t_result         = DATA(lt_result)
      CHANGING
        it_selected_data = lt_data ).

    LOOP AT lt_result INTO DATA(lwa_result).
      READ TABLE lt_doc_msg ASSIGNING FIELD-SYMBOL(<fs_msg>)
        WITH TABLE KEY companycode       = lwa_result-companycode
                       inventorydocument = lwa_result-inventorydocument
                       fiscalyear        = lwa_result-fiscalyear.
      IF sy-subrc <> 0.
        INSERT VALUE #(
          companycode       = lwa_result-companycode
          inventorydocument = lwa_result-inventorydocument
          fiscalyear        = lwa_result-fiscalyear
          success           = lwa_result-success
          message           = lwa_result-message
        ) INTO TABLE lt_doc_msg.
      ELSEIF lwa_result-success IS INITIAL AND <fs_msg>-success = abap_true.
        <fs_msg>-success = abap_false.
        <fs_msg>-message = lwa_result-message.
      ENDIF.
    ENDLOOP.

    LOOP AT lt_doc_msg INTO DATA(ls_doc_msg).
      READ TABLE lt_action_keys INTO DATA(lwa_keys)
        WITH TABLE KEY companycode       = ls_doc_msg-companycode
                       inventorydocument = ls_doc_msg-inventorydocument
                       fiscalyear        = ls_doc_msg-fiscalyear.
      IF sy-subrc = 0.

        IF ls_doc_msg-success = abap_true.
          reported-zi_mm_invent_closing_ship = VALUE #( BASE reported-zi_mm_invent_closing_ship (
            %tky = lwa_keys-%tky
            %msg = new_message_with_text(
                     severity = if_abap_behv_message=>severity-success
                     text     = ls_doc_msg-message ) ) ).
        ELSE.
          reported-zi_mm_invent_closing_ship = VALUE #( BASE reported-zi_mm_invent_closing_ship (
            %tky = lwa_keys-%tky
            %msg = new_message_with_text(
                     severity = if_abap_behv_message=>severity-error
                     text     = ls_doc_msg-message ) ) ).
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD rba_Item.
    DATA(lo_query) = NEW zcl_mm_query_invent_item( ).

    LOOP AT keys_rba INTO DATA(ls_key).
      DATA(lt_item) = lo_query->get_items(
        iv_companycode = ls_key-CompanyCode
        iv_document    = ls_key-InventoryDocument
        iv_fiscalyear  = ls_key-FiscalYear ).

      LOOP AT lt_item INTO DATA(ls_item).
        IF result_requested = abap_true.
          DATA ls_result LIKE LINE OF result.
          CLEAR ls_result.
          ls_result = CORRESPONDING #( ls_item ).
          ls_result-%tky = CORRESPONDING #( ls_item ).
          INSERT ls_result INTO TABLE result.
        ENDIF.

        INSERT VALUE #(
          source-%tky = ls_key-%tky
          target-%tky = CORRESPONDING #( ls_item )
        ) INTO TABLE association_links.
      ENDLOOP.
    ENDLOOP.
  ENDMETHOD.

ENDCLASS.

CLASS lhc_ZI_MM_INVENT_CLOSING_ITEM DEFINITION INHERITING FROM cl_abap_behavior_handler.
  PRIVATE SECTION.
    METHODS read FOR READ
      IMPORTING keys FOR READ zi_mm_invent_closing_item RESULT result.

    METHODS rba_Header FOR READ
      IMPORTING keys_rba FOR READ zi_mm_invent_closing_item\_Header FULL result_requested RESULT result LINK association_links.
ENDCLASS.

CLASS lhc_ZI_MM_INVENT_CLOSING_ITEM IMPLEMENTATION.

  METHOD read.
    DATA(lo_query) = NEW zcl_mm_query_invent_item( ).

    LOOP AT keys INTO DATA(ls_key).
      DATA(lt_item) = lo_query->get_items(
        iv_companycode = ls_key-CompanyCode
        iv_document    = ls_key-InventoryDocument
        iv_fiscalyear  = ls_key-FiscalYear
        iv_item        = ls_key-InventoryDocumentItem ).

      READ TABLE lt_item INTO DATA(ls_item) INDEX 1.
      IF sy-subrc = 0.
        DATA ls_read LIKE LINE OF result.
        CLEAR ls_read.
        ls_read = CORRESPONDING #( ls_item ).
        ls_read-%tky = CORRESPONDING #( ls_item ).
        APPEND ls_read TO result.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD rba_Header.
    TYPES: BEGIN OF ty_doc_key,
             companycode       TYPE bukrs,
             inventorydocument TYPE iblnr,
             fiscalyear        TYPE gjahr,
           END OF ty_doc_key.

    DATA lt_seen        TYPE HASHED TABLE OF ty_doc_key WITH UNIQUE KEY companycode inventorydocument fiscalyear.
    DATA lt_parent_key  TYPE TABLE FOR READ IMPORT zi_mm_invent_closing_ship.

    LOOP AT keys_rba INTO DATA(ls_key).
      INSERT VALUE #(
        companycode       = ls_key-CompanyCode
        inventorydocument = ls_key-InventoryDocument
        fiscalyear        = ls_key-FiscalYear
      ) INTO TABLE lt_seen.
    ENDLOOP.

    LOOP AT lt_seen INTO DATA(ls_seen).
      APPEND VALUE #(
        CompanyCode       = ls_seen-companycode
        InventoryDocument = ls_seen-inventorydocument
        FiscalYear        = ls_seen-fiscalyear
      ) TO lt_parent_key.
    ENDLOOP.

    READ ENTITIES OF zi_mm_invent_closing_ship IN LOCAL MODE
      ENTITY zi_mm_invent_closing_ship
      ALL FIELDS WITH CORRESPONDING #( lt_parent_key )
      RESULT DATA(lt_header).

    TYPES ty_header LIKE LINE OF lt_header.
    DATA lt_header_idx TYPE HASHED TABLE OF ty_header
      WITH UNIQUE KEY companycode inventorydocument fiscalyear.
    INSERT LINES OF lt_header INTO TABLE lt_header_idx.

    IF result_requested = abap_true.
      result = CORRESPONDING #( lt_header ).
    ENDIF.

    LOOP AT keys_rba INTO ls_key.
      READ TABLE lt_header_idx INTO DATA(ls_header)
        WITH TABLE KEY companycode       = ls_key-CompanyCode
                       inventorydocument = ls_key-InventoryDocument
                       fiscalyear        = ls_key-FiscalYear.
      IF sy-subrc = 0.
        INSERT VALUE #(
          source-%tky = ls_key-%tky
          target-%tky = ls_header-%tky
        ) INTO TABLE association_links.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

ENDCLASS.

CLASS lsc_ZI_MM_INVENT_CLOSING_SHIP DEFINITION INHERITING FROM cl_abap_behavior_saver.
  PROTECTED SECTION.

    METHODS finalize REDEFINITION.
    METHODS check_before_save REDEFINITION.
    METHODS save REDEFINITION.
    METHODS cleanup REDEFINITION.
    METHODS cleanup_finalize REDEFINITION.

ENDCLASS.

CLASS lsc_ZI_MM_INVENT_CLOSING_SHIP IMPLEMENTATION.

  METHOD finalize.
  ENDMETHOD.

  METHOD check_before_save.
  ENDMETHOD.

  METHOD save.
    DATA lt_update TYPE STANDARD TABLE OF zinv_documentos.

    lt_update = lcl_buffer=>gt_zinv_update.
    IF lt_update IS INITIAL.
      RETURN.
    ENDIF.

    SELECT *
      FROM zinv_documentos
      FOR ALL ENTRIES IN @lt_update
      WHERE bukrs = @lt_update-bukrs
        AND iblnr = @lt_update-iblnr
        AND zeile = @lt_update-zeile
        AND gjahr = @lt_update-gjahr
      INTO TABLE @DATA(lt_current).

    DATA lt_upd_idx TYPE HASHED TABLE OF zinv_documentos
      WITH UNIQUE KEY bukrs iblnr zeile gjahr.
    INSERT LINES OF lt_update INTO TABLE lt_upd_idx.

    LOOP AT lt_current ASSIGNING FIELD-SYMBOL(<fs_row>).
      READ TABLE lt_upd_idx INTO DATA(ls_upd)
        WITH TABLE KEY bukrs = <fs_row>-bukrs
                       iblnr = <fs_row>-iblnr
                       zeile = <fs_row>-zeile
                       gjahr = <fs_row>-gjahr.
      IF sy-subrc = 0.
        <fs_row>-status        = ls_upd-status.
        <fs_row>-delta_id      = ls_upd-delta_id.
        <fs_row>-error_message = ls_upd-error_message.
        <fs_row>-last_sync_at  = ls_upd-last_sync_at.
        <fs_row>-last_sync_by  = ls_upd-last_sync_by.
      ENDIF.
    ENDLOOP.

    IF lt_current IS NOT INITIAL.
      UPDATE zinv_documentos FROM TABLE @lt_current.
    ENDIF.

    DATA lt_current_idx TYPE HASHED TABLE OF zinv_documentos
      WITH UNIQUE KEY bukrs iblnr zeile gjahr.
    INSERT LINES OF lt_current INTO TABLE lt_current_idx.

    DATA lt_insert TYPE STANDARD TABLE OF zinv_documentos.
    LOOP AT lt_update INTO DATA(ls_new).
      READ TABLE lt_current_idx TRANSPORTING NO FIELDS
        WITH TABLE KEY bukrs = ls_new-bukrs
                       iblnr = ls_new-iblnr
                       zeile = ls_new-zeile
                       gjahr = ls_new-gjahr.
      IF sy-subrc <> 0.
        APPEND ls_new TO lt_insert.
      ENDIF.
    ENDLOOP.

    IF lt_insert IS NOT INITIAL.
      INSERT zinv_documentos FROM TABLE @lt_insert.
    ENDIF.

    CLEAR lcl_buffer=>gt_zinv_update.
  ENDMETHOD.

  METHOD cleanup.
    CLEAR lcl_buffer=>gt_zinv_update.
  ENDMETHOD.

  METHOD cleanup_finalize.
    CLEAR lcl_buffer=>gt_zinv_update.
  ENDMETHOD.

ENDCLASS.
