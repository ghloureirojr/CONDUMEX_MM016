CLASS lcl_buffer DEFINITION CREATE PRIVATE.
  PUBLIC SECTION.
    CLASS-DATA: gt_zinv_update TYPE TABLE OF zinv_documentos WITH DEFAULT KEY.
ENDCLASS.

CLASS lhc_ZI_MM_INVENT_CLOSING_SHIP DEFINITION INHERITING FROM cl_abap_behavior_handler.
  PRIVATE SECTION.

    METHODS get_instance_authorizations FOR INSTANCE AUTHORIZATION
      IMPORTING keys REQUEST requested_authorizations FOR zi_mm_invent_closing_ship RESULT result.

    METHODS read FOR READ
      IMPORTING keys FOR READ zi_mm_invent_closing_ship RESULT result.

    METHODS lock FOR LOCK
      IMPORTING keys FOR LOCK zi_mm_invent_closing_ship.

    METHODS sendcpi FOR MODIFY
      IMPORTING keys FOR ACTION zi_mm_invent_closing_ship~sendcpi.

ENDCLASS.

CLASS lhc_ZI_MM_INVENT_CLOSING_SHIP IMPLEMENTATION.

  METHOD get_instance_authorizations.
  ENDMETHOD.

  METHOD read.
    FIELD-SYMBOLS: <fs_result> TYPE STRUCTURE FOR READ RESULT zi_mm_invent_closing_ship.

    IF keys IS INITIAL.
      RETURN.
    ENDIF.

    SELECT *
      FROM zinv_documentos
      FOR ALL ENTRIES IN @keys
      WHERE bukrs = @keys-CompanyCode
        AND iblnr = @keys-InventoryDocument
        AND gjahr = @keys-FiscalYear
      INTO TABLE @DATA(lt_zinv_documentos).

    SELECT *
      FROM zi_inv_delta_contabi
      FOR ALL ENTRIES IN @keys
      WHERE bukrs             = @keys-CompanyCode
        AND inventorydocument = @keys-InventoryDocument
        AND fiscalyear        = @keys-FiscalYear
      INTO TABLE @DATA(lt_zi_inv_delta_contabi).

    DATA lv_filled TYPE abap_bool.

    LOOP AT keys INTO DATA(ls_key).
      lv_filled = abap_false.

      APPEND INITIAL LINE TO result ASSIGNING <fs_result>.
      <fs_result>-CompanyCode       = ls_key-CompanyCode.
      <fs_result>-InventoryDocument = ls_key-InventoryDocument.
      <fs_result>-FiscalYear        = ls_key-FiscalYear.

      LOOP AT lt_zinv_documentos INTO DATA(ls_z)
        WHERE bukrs = ls_key-CompanyCode
          AND iblnr = ls_key-InventoryDocument
          AND gjahr = ls_key-FiscalYear.
        IF lv_filled = abap_false OR ls_z-last_sync_at > <fs_result>-LastSyncAt.
          <fs_result>-Plant             = ls_z-werks.
          <fs_result>-Almacen           = ls_z-lgort.
          <fs_result>-DocumentDate      = ls_z-bldat.
          <fs_result>-SyncStatusCode    = ls_z-status.
          <fs_result>-Nameupd           = ls_z-last_sync_by.
          <fs_result>-LastSyncAt        = ls_z-last_sync_at.
          <fs_result>-DeltaId           = ls_z-delta_id.
          <fs_result>-ErrorMessage      = ls_z-error_message.
          <fs_result>-DocumentDateConta = ls_z-budat.
          lv_filled = abap_true.
        ENDIF.
      ENDLOOP.

      IF lv_filled = abap_true.
        CONTINUE.
      ENDIF.

      LOOP AT lt_zi_inv_delta_contabi INTO DATA(ls_d)
        WHERE bukrs             = ls_key-CompanyCode
          AND inventorydocument = ls_key-InventoryDocument
          AND fiscalyear        = ls_key-FiscalYear.
        <fs_result>-Plant             = ls_d-plant.
        <fs_result>-Almacen           = ls_d-almacen.
        <fs_result>-DocumentDate      = ls_d-documentdate.
        <fs_result>-SyncStatusCode    = ls_d-syncstatuscode.
        <fs_result>-Nameupd           = ls_d-nameupd.
        <fs_result>-LastSyncAt        = ls_d-lastsyncat.
        <fs_result>-DeltaId           = ls_d-deltaid.
        <fs_result>-ErrorMessage      = ls_d-errormessage.
        <fs_result>-DocumentDateConta = ls_d-documentdateconta.
        EXIT.
      ENDLOOP.
    ENDLOOP.
  ENDMETHOD.

  METHOD lock.
  ENDMETHOD.

  METHOD sendcpi.
    DATA: gr_handler TYPE REF TO zcl_inv_clo_cpi,
          lt_data    TYPE zcl_inv_clo_cpi=>tt_inventory_alv.

    TYPES: BEGIN OF ty_doc_msg,
             companycode       TYPE bukrs,
             inventorydocument TYPE iblnr,
             fiscalyear        TYPE gjahr,
             success           TYPE abap_bool,
             message           TYPE string,
           END OF ty_doc_msg.

    DATA lt_doc_msg TYPE STANDARD TABLE OF ty_doc_msg.

    IF keys IS INITIAL.
      RETURN.
    ENDIF.

    SELECT *
      FROM zinv_documentos
      FOR ALL ENTRIES IN @keys
      WHERE bukrs = @keys-CompanyCode
        AND iblnr = @keys-InventoryDocument
        AND gjahr = @keys-FiscalYear
      INTO TABLE @DATA(lt_zinv).

    SELECT *
      FROM zi_inv_delta_contabi
      FOR ALL ENTRIES IN @keys
      WHERE bukrs             = @keys-CompanyCode
        AND inventorydocument = @keys-InventoryDocument
        AND fiscalyear        = @keys-FiscalYear
      INTO TABLE @DATA(lt_delta).

    LOOP AT lt_zinv INTO DATA(ls_z).
      APPEND VALUE #(
        bukrs             = ls_z-bukrs
        inventorydocument = ls_z-iblnr
        fiscalyear        = ls_z-gjahr
        plant             = ls_z-werks
        almacen           = ls_z-lgort
        material          = ls_z-matnr
        item              = ls_z-zeile
        documentdate      = ls_z-bldat
        quantity          = ls_z-erfmg
        quantityzero      = ls_z-xnull
        baseunitofmeasure = ls_z-meins
        syncstatuscode    = ls_z-status
        nameupd           = ls_z-last_sync_by
        lastsyncat        = ls_z-last_sync_at
        deltaid           = ls_z-delta_id
        menerror          = ls_z-error_message
        documentdateconta = ls_z-budat
      ) TO lt_data.
    ENDLOOP.

    SORT lt_zinv BY bukrs iblnr gjahr zeile.

    LOOP AT lt_delta INTO DATA(ls_d).
      READ TABLE lt_zinv TRANSPORTING NO FIELDS
        WITH KEY bukrs = ls_d-bukrs
                 iblnr = ls_d-inventorydocument
                 gjahr = ls_d-fiscalyear
                 zeile = ls_d-inventorydocumentitem
        BINARY SEARCH.
      IF sy-subrc = 0.
        CONTINUE.
      ENDIF.

      APPEND VALUE #(
        bukrs             = ls_d-bukrs
        inventorydocument = ls_d-inventorydocument
        fiscalyear        = ls_d-fiscalyear
        plant             = ls_d-plant
        almacen           = ls_d-almacen
        material          = ls_d-material
        item              = ls_d-inventorydocumentitem
        documentdate      = ls_d-documentdate
        quantity          = ls_d-quantity
        quantityzero      = ls_d-quantityzero
        baseunitofmeasure = ls_d-baseunitofmeasure
        syncstatuscode    = ls_d-syncstatuscode
        nameupd           = ls_d-nameupd
        lastsyncat        = ls_d-lastsyncat
        deltaid           = ls_d-deltaid
        menerror          = ls_d-errormessage
        documentdateconta = ls_d-documentdateconta
      ) TO lt_data.
    ENDLOOP.

    IF lt_data IS INITIAL.
      LOOP AT keys INTO DATA(ls_key_empty).
        reported-zi_mm_invent_closing_ship = VALUE #( BASE reported-zi_mm_invent_closing_ship (
          %tky = ls_key_empty-%tky
          %msg = new_message_with_text(
                   severity = if_abap_behv_message=>severity-error
                   text     = 'No hay posiciones para el documento de inventario.' ) ) ).
      ENDLOOP.
      RETURN.
    ENDIF.

    CREATE OBJECT gr_handler.

    gr_handler->send_data_to_cpi(
      IMPORTING
        t_zinv_update    = lcl_buffer=>gt_zinv_update
        t_result         = DATA(lt_result)
      CHANGING
        it_selected_data = lt_data ).

    LOOP AT lt_result INTO DATA(lwa_result).
      READ TABLE lt_doc_msg ASSIGNING FIELD-SYMBOL(<fs_msg>)
        WITH KEY companycode       = lwa_result-companycode
                 inventorydocument = lwa_result-inventorydocument
                 fiscalyear        = lwa_result-fiscalyear.
      IF sy-subrc <> 0.
        APPEND VALUE #(
          companycode       = lwa_result-companycode
          inventorydocument = lwa_result-inventorydocument
          fiscalyear        = lwa_result-fiscalyear
          success           = lwa_result-success
          message           = lwa_result-message
        ) TO lt_doc_msg.
      ELSEIF lwa_result-success IS INITIAL AND <fs_msg>-success = abap_true.
        <fs_msg>-success = abap_false.
        <fs_msg>-message = lwa_result-message.
      ENDIF.
    ENDLOOP.

    LOOP AT lt_doc_msg INTO DATA(ls_doc_msg).
      LOOP AT keys INTO DATA(lwa_keys)
        WHERE CompanyCode       = ls_doc_msg-companycode
          AND InventoryDocument = ls_doc_msg-inventorydocument
          AND FiscalYear        = ls_doc_msg-fiscalyear.

        IF ls_doc_msg-success = abap_true.
          reported-zi_mm_invent_closing_ship = VALUE #( BASE reported-zi_mm_invent_closing_ship (
            %tky = lwa_keys-%tky
            %msg = new_message_with_text(
                     severity = if_abap_behv_message=>severity-success
                     text     = ls_doc_msg-message ) ) ).
        ELSE.
          failed-zi_mm_invent_closing_ship = VALUE #( BASE failed-zi_mm_invent_closing_ship (
            %tky = lwa_keys-%tky ) ).
          reported-zi_mm_invent_closing_ship = VALUE #( BASE reported-zi_mm_invent_closing_ship (
            %tky = lwa_keys-%tky
            %msg = new_message_with_text(
                     severity = if_abap_behv_message=>severity-error
                     text     = ls_doc_msg-message ) ) ).
        ENDIF.
        EXIT.
      ENDLOOP.
    ENDLOOP.
  ENDMETHOD.

ENDCLASS.

CLASS lsc_ZI_MM_INVENT_CLOSING_SHIP DEFINITION INHERITING FROM cl_abap_behavior_saver.
  PROTECTED SECTION.

    METHODS finalize REDEFINITION.
    METHODS check_before_save REDEFINITION.
    METHODS save REDEFINITION.
    METHODS cleanup REDEFINITION.
    METHODS cleanup_finalize REDEFINITION.

ENDCLASS.

CLASS lsc_ZI_MM_INVENT_CLOSING_SHIP IMPLEMENTATION.

  METHOD finalize.
  ENDMETHOD.

  METHOD check_before_save.
  ENDMETHOD.

  METHOD save.
    LOOP AT lcl_buffer=>gt_zinv_update INTO DATA(ls_zinv).
      UPDATE zinv_documentos
        SET status        = @ls_zinv-status,
            delta_id      = @ls_zinv-delta_id,
            error_message = @ls_zinv-error_message,
            last_sync_at  = @ls_zinv-last_sync_at,
            last_sync_by  = @ls_zinv-last_sync_by
        WHERE bukrs = @ls_zinv-bukrs
          AND iblnr = @ls_zinv-iblnr
          AND zeile = @ls_zinv-zeile
          AND gjahr = @ls_zinv-gjahr.

      IF sy-subrc <> 0.
        MODIFY zinv_documentos FROM @ls_zinv.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD cleanup.
  ENDMETHOD.

  METHOD cleanup_finalize.
  ENDMETHOD.

ENDCLASS.
