CLASS zcl_inv_clo_cpi DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
    " Estructura para el ALV referenciada a la nueva CDS View Entity
    TYPES: BEGIN OF ty_inventory_alv,
             sel               TYPE char1,
             Bukrs             TYPE zi_inv_delta_contabi-Bukrs,
             InventoryDocument TYPE zi_inv_delta_contabi-InventoryDocument,
             FiscalYear        TYPE zi_inv_delta_contabi-FiscalYear,
             Plant             TYPE zi_inv_delta_contabi-Plant,
             Almacen           TYPE zi_inv_delta_contabi-Almacen,
             Material          TYPE zi_inv_delta_contabi-Material,
             Item              TYPE zi_inv_delta_contabi-InventoryDocumentItem,
             DocumentDate      TYPE zi_inv_delta_contabi-DocumentDate,
             Quantity          TYPE zi_inv_delta_contabi-Quantity,
             QuantityZero      TYPE zi_inv_delta_contabi-QuantityZero,
             BaseUnitOfMeasure TYPE zi_inv_delta_contabi-BaseUnitOfMeasure,
             SyncStatusCode    TYPE zi_inv_delta_contabi-SyncStatusCode,
             NameUpd           TYPE zi_inv_delta_contabi-Nameupd,
             LastSyncAt        TYPE zi_inv_delta_contabi-LastSyncAt,
             DeltaID           TYPE zi_inv_delta_contabi-DeltaID,
             MenError          TYPE zi_inv_delta_contabi-ErrorMessage,
             DocumentDateConta TYPE zi_inv_delta_contabi-DocumentDateConta,

           END OF ty_inventory_alv,

           BEGIN OF ty_result,
             companycode           TYPE bukrs,
             inventorydocument     TYPE iblnr,
             inventorydocumentitem TYPE dzeile,
             fiscalyear            TYPE gjahr,
             success               TYPE abap_bool,
             message               TYPE string,
           END OF ty_result.

    TYPES: tt_inventory_alv TYPE STANDARD TABLE OF ty_inventory_alv WITH EMPTY KEY,
           tt_zinv_update   TYPE TABLE OF zinv_documentos WITH DEFAULT KEY,
           tt_result        TYPE TABLE OF ty_result WITH DEFAULT KEY.

    METHODS get_inventory_data
      IMPORTING
        !iv_year       TYPE zi_invdoc_soap_ext-fiscalyear
        !iv_plant      TYPE zi_invdoc_soap_ext-plant
        !iv_status     TYPE char1 " 'X' Contado, ' ' No Contado
      RETURNING
        VALUE(rv_data) TYPE tt_inventory_alv .

    METHODS send_data_to_cpi
      EXPORTING
        !ev_success       TYPE abap_bool
        !ev_message       TYPE string
        !t_zinv_update    TYPE tt_zinv_update
        !t_result         TYPE tt_result
      CHANGING
        !it_selected_data TYPE tt_inventory_alv.

protected section.
private section.
ENDCLASS.



CLASS ZCL_INV_CLO_CPI IMPLEMENTATION.


  METHOD get_inventory_data.

    DATA: lt_zinv_update TYPE TABLE OF zinv_documentos,
          lv_timestamp   TYPE timestampl.

    GET TIME STAMP FIELD lv_timestamp.
    DATA(lv_timestamp_iso) = |{ lv_timestamp TIMESTAMP = ISO }|.

    SELECT FROM zinv_documentos
      FIELDS
      bukrs,iblnr,zeile,gjahr,werks,lgort,matnr,bldat,
      budat,erfmg,xnull,meins,status,delta_id,error_message,
      last_sync_at,last_sync_by,fechaconteo,fechaconta
      WHERE werks = @iv_plant
        AND gjahr = @iv_year
        AND status IN ( 'CONTADO', 'CONTADO_ER' )
       INTO TABLE @DATA(lt_zdocumentos_exist).

    IF lt_zdocumentos_exist IS NOT INITIAL.
      SELECT
        FROM zi_inv_delta_contabi AS a
        JOIN @lt_zdocumentos_exist AS b
          ON a~fiscalyear <> b~gjahr
         AND a~inventorydocumentitem <> b~zeile
         AND a~inventorydocument <> b~iblnr
        FIELDS
          a~Bukrs,
          a~InventoryDocument,
          a~InventoryDocumentItem,
          a~FiscalYear,
          a~Plant,
          a~Almacen,
          a~Material,
          a~DocumentDate,
          b~status,
          a~Quantity,
          a~QuantityZero,
          a~BaseUnitOfMeasure,
          b~delta_id,
          b~error_message,
          b~last_sync_at,
          a~Nameupd,
          a~DocumentDateConta,
          b~fechaconteo
        INTO TABLE @DATA(lt_db_results).
      IF lt_db_results IS NOT INITIAL.
        LOOP AT lt_db_results ASSIGNING FIELD-SYMBOL(<fs_cds0>).
          APPEND INITIAL LINE TO lt_zdocumentos_exist ASSIGNING FIELD-SYMBOL(<fs_z>).
          <fs_z>-bukrs = <fs_cds0>-Bukrs.
          <fs_z>-iblnr = <fs_cds0>-inventorydocument.
          <fs_z>-zeile = <fs_cds0>-inventorydocumentitem.
          <fs_z>-gjahr = <fs_cds0>-fiscalyear.
          <fs_z>-werks = <fs_cds0>-plant.
          <fs_z>-lgort = <fs_cds0>-almacen.
          <fs_z>-matnr = <fs_cds0>-material.
          <fs_z>-budat = <fs_cds0>-documentdate.
          <fs_z>-status = <fs_cds0>-status.
          <fs_z>-erfmg = <fs_cds0>-quantity.
          <fs_z>-xnull = <fs_cds0>-quantityzero.
          <fs_z>-meins = <fs_cds0>-baseunitofmeasure.
          <fs_z>-delta_id = <fs_cds0>-delta_id.
          <fs_z>-error_message = <fs_cds0>-error_message.
          <fs_z>-last_sync_at = <fs_cds0>-last_sync_at.
          <fs_z>-last_sync_by = <fs_cds0>-nameupd.
          <fs_z>-fechaconteo = <fs_cds0>-fechaconteo.
          <fs_z>-fechaconta = <fs_cds0>-DocumentDateConta.
        ENDLOOP.
      ENDIF.
*    ELSE.
*      SELECT FROM zi_inv_delta_contabi AS a
*          FIELDS
*          a~Bukrs,
*          a~InventoryDocument,
*          a~InventoryDocumentItem,
*          a~FiscalYear,
*          a~Plant,
*          a~Almacen,
*          a~Material,
*          a~DocumentDate,
*          a~SyncStatusCode,
*          a~Quantity,
*          a~QuantityZero,
*          a~BaseUnitOfMeasure,
*          a~Status,
*          a~DeltaID,
*          a~ErrorMessage,
*          a~LastSyncAt,
*          a~Nameupd,
*          a~DocumentDateConta,
*          a~fechaconteo
*                   FOR ALL ENTRIES IN @lt_zdocumentos_exist
*              WHERE fiscalyear NE @lt_zdocumentos_exist-gjahr
*                AND  inventorydocumentitem     NE @lt_zdocumentos_exist-zeile
*                AND  inventorydocument     NE @lt_zdocumentos_exist-iblnr
**          AND  quantity     NE @lt_zdocumentos_exist-erfmg
**          AND  status NE @lt_zdocumentos_exist-status
*              INTO TABLE @DATA(lt_db_results0).
*
*      IF lt_db_results0 IS NOT INITIAL.
*
*        LOOP AT lt_db_results0 ASSIGNING FIELD-SYMBOL(<fs_cds00>).
*
*          APPEND INITIAL LINE TO lt_zdocumentos_exist ASSIGNING FIELD-SYMBOL(<fs_z0>).
*
*          <fs_z0>-bukrs = <fs_cds00>-Bukrs.
*          <fs_z0>-iblnr = <fs_cds00>-inventorydocument.
*          <fs_z0>-zeile = <fs_cds00>-inventorydocumentitem.
*          <fs_z0>-gjahr = <fs_cds00>-fiscalyear.
*          <fs_z0>-werks = <fs_cds00>-plant.
*          <fs_z0>-lgort = <fs_cds00>-almacen.
*          <fs_z0>-matnr = <fs_cds00>-material.
*          <fs_z0>-budat = <fs_cds00>-documentdate.
*          <fs_z0>-status = <fs_cds00>-syncstatuscode.
*          <fs_z0>-erfmg = <fs_cds00>-quantity.
*          <fs_z0>-xnull = <fs_cds00>-quantityzero.
*          <fs_z0>-meins = <fs_cds00>-baseunitofmeasure.
*          <fs_z0>-status = <fs_cds00>-status.
*          <fs_z0>-delta_id = <fs_cds00>-deltaid.
*          <fs_z0>-error_message = <fs_cds00>-errormessage.
*          <fs_z0>-last_sync_at = <fs_cds00>-lastsyncat.
*          <fs_z0>-last_sync_by = <fs_cds00>-nameupd.
*          <fs_z0>-fechaconteo = <fs_cds00>-fechaconteo.
*          <fs_z0>-fechaconta = <fs_cds00>-DocumentDateConta.
*
*        ENDLOOP.
*      ENDIF.
    ENDIF.

    SORT lt_zdocumentos_exist BY iblnr gjahr zeile.
    rv_data = VALUE #(
         FOR <fs_cds> IN lt_zdocumentos_exist (
           inventorydocument = <fs_cds>-iblnr
           fiscalyear        = <fs_cds>-gjahr
           bukrs             = <fs_cds>-bukrs
           plant             = <fs_cds>-werks
           almacen           = <fs_cds>-lgort
           material          = <fs_cds>-matnr
           quantity          = <fs_cds>-erfmg
           item              = <fs_cds>-zeile
           baseunitofmeasure = <fs_cds>-meins
           quantityzero      = <fs_cds>-xnull
           nameupd           = <fs_cds>-last_sync_by
           syncstatuscode    = <fs_cds>-status
           documentdate      = <fs_cds>-budat
           deltaid           = <fs_cds>-delta_id
           lastsyncat        = lv_timestamp_iso
           menerror          = <fs_cds>-error_message
         )
       ).

    lt_zinv_update = VALUE #(
      FOR <fs_cds1> IN lt_zdocumentos_exist (
        iblnr         = <fs_cds1>-iblnr
        gjahr         = <fs_cds1>-gjahr
        bukrs         = <fs_cds1>-bukrs
        werks         = <fs_cds1>-werks
        lgort         = <fs_cds1>-lgort
        matnr         = <fs_cds1>-matnr
        erfmg         = <fs_cds1>-erfmg
        zeile         = <fs_cds1>-zeile
        meins         = <fs_cds1>-meins
        xnull         = <fs_cds1>-xnull
        last_sync_by  = <fs_cds1>-last_sync_by
        status        = <fs_cds1>-status
        bldat         = <fs_cds1>-budat
        delta_id      = <fs_cds1>-delta_id
        last_sync_at  = lv_timestamp_iso
        error_message = <fs_cds1>-error_message
      )
    ).

    IF lt_zinv_update IS NOT INITIAL.
      MODIFY zinv_documentos FROM TABLE lt_zinv_update.
      IF sy-subrc = 0.
        COMMIT WORK.
      ELSE.
        ROLLBACK WORK. "
      ENDIF.
    ENDIF.
  ENDMETHOD.


  METHOD send_data_to_cpi.
    DATA: lo_proxy         TYPE REF TO zcoco_servicio_cierre_port_typ,
          ls_request       TYPE zcosolicitar_cierre_input,
          ls_response      TYPE zcosolicitar_cierre_output,
          lo_sys_exception TYPE REF TO cx_ai_system_fault.

    DATA: lt_selected_items TYPE tt_inventory_alv,
          lt_zinv_update    TYPE TABLE OF zinv_documentos,
          ls_zinv           TYPE zinv_documentos.

    FIELD-SYMBOLS : <fs_result> TYPE ty_result,
                    <fs_doc>    TYPE ty_inventory_alv.

*    ev_success = abap_false.
    lt_selected_items = CORRESPONDING #( it_selected_data ).

*    IF lines( lt_selected_items ) = 0.
*      ev_message = 'No se han seleccionado posiciones para enviar.'.
*      RETURN.
*    ENDIF.
    " Centralizar TimeStamp
    GET TIME STAMP FIELD DATA(lv_timestamp).
    DATA(lv_timestamp_iso) = |{ lv_timestamp TIMESTAMP = ISO }|.

    " Instanciar proxy una sola vez
    TRY.
        lo_proxy = NEW zcoco_servicio_cierre_port_typ( logical_port_name = 'ZLP_TRM_PROP_PAGO_CPI' ).
      CATCH cx_ai_system_fault INTO lo_sys_exception.
*        ev_message = |Error inicializando proxy: { lo_sys_exception->get_text( ) }|.
        LOOP AT lt_selected_items ASSIGNING <fs_doc>.
          APPEND INITIAL LINE TO t_result ASSIGNING <fs_result>.
          <fs_result>-companycode = <fs_doc>-bukrs.
          <fs_result>-inventorydocument = <fs_doc>-inventorydocument.
          <fs_result>-inventorydocumentitem = <fs_doc>-item.
          <fs_result>-fiscalyear  = <fs_doc>-fiscalyear.
          <fs_result>-success = abap_false.
          <fs_result>-message = |Error inicializando proxy: { lo_sys_exception->get_text( ) }|.

        ENDLOOP.
        RETURN.
    ENDTRY.



    " Lógica: Agrupar por documento (Un Request SOAP por Documento de Inventario)
    LOOP AT lt_selected_items ASSIGNING <fs_doc>
                              GROUP BY ( bukrs             = <fs_doc>-bukrs
                                         plant             = <fs_doc>-plant
                                         inventorydocument = <fs_doc>-inventorydocument )
                              ASSIGNING FIELD-SYMBOL(<fs_group>).

      CLEAR ls_request.

      TRY.
          DATA(lv_uuid) = cl_system_uuid=>create_uuid_c32_static( ).
        CATCH cx_uuid_error INTO DATA(lx_uuid).
          DATA(ev_estatus) = 'Error'.
          DATA(ev_error_msg) = lx_uuid->get_longtext(  ).
      ENDTRY.



      " Llenar Cabecera
      ls_request-encabezado-id_solicitud  = lv_uuid.
      ls_request-encabezado-tipo_archivo      = 'Cierre'.
      ls_request-encabezado-sociedad          = <fs_group>-bukrs.
      ls_request-encabezado-no_documento_sap  = <fs_group>-inventorydocument.
      ls_request-encabezado-centro  = <fs_group>-plant.
      ls_request-encabezado-fecha_hora_cierre_doc  = lv_timestamp_iso.
      ls_request-encabezado-cierre_documento = '1'.


      " Enviar mensaje SOAP
      TRY.
          lo_proxy->solicitar_cierre(
            EXPORTING
              input  = ls_request
            IMPORTING
              output = ls_response ).

          IF ls_response-id_solicitud = '200'.

            READ TABLE lt_selected_items ASSIGNING <fs_doc> WITH KEY InventoryDocument = <fs_group>-inventorydocument.
            IF sy-subrc = 0.

              <fs_doc>-deltaid = lv_uuid.
              <fs_doc>-syncstatuscode = 'Envío exitoso a CPI'.
*              ev_success = abap_true.
              " Preparar actualización log - Éxito
              ls_zinv = VALUE #(

                               bukrs = <fs_doc>-bukrs
                               iblnr         = <fs_group>-inventorydocument
                               gjahr         = sy-datum(4)
                               werks = <fs_doc>-plant
                               lgort = <fs_doc>-almacen
                               matnr = <fs_doc>-material
                               bldat = <fs_doc>-documentdate
                               erfmg = <fs_doc>-quantity
                               meins = <fs_doc>-baseunitofmeasure
                               zeile         =  <fs_doc>-item
                               delta_id      = lv_uuid
                               status       = 'SEND'
                               last_sync_at  = lv_timestamp_iso
                               last_sync_by  = sy-uname
                               error_message =  ls_response-mensaje
                                ).
              APPEND ls_zinv TO lt_zinv_update.
*              ev_success = abap_true.
*              ev_message = 'Envío exitoso a CPI'.
              <fs_doc>-menerror =  ev_message.
              APPEND INITIAL LINE TO t_result ASSIGNING <fs_result>.
              <fs_result>-companycode = <fs_doc>-bukrs.
              <fs_result>-inventorydocument = <fs_doc>-inventorydocument.
              <fs_result>-inventorydocumentitem = <fs_doc>-item.
              <fs_result>-fiscalyear  = <fs_doc>-fiscalyear.
              <fs_result>-success = abap_true.
              <fs_result>-message = 'Envío exitoso a CPI'.
*              MODIFY zinv_documentos FROM ls_zinv.

            ELSE.
              LOOP AT lt_selected_items ASSIGNING <fs_doc> WHERE InventoryDocument = <fs_group>-inventorydocument.
                ls_zinv = VALUE #(
                                     bukrs = <fs_doc>-bukrs
                                     iblnr         = <fs_group>-inventorydocument
                                     gjahr         = sy-datum(4)
                                     werks = <fs_doc>-plant
                                     lgort = <fs_doc>-almacen
                                     matnr = <fs_doc>-material
                                     bldat = <fs_doc>-documentdate
                                     erfmg = <fs_doc>-quantity
                                     meins = <fs_doc>-baseunitofmeasure
                                     zeile         =  <fs_doc>-item
                                     delta_id      = lv_uuid
                                     status        = 'NOTSENT'
                                     last_sync_at  = lv_timestamp_iso
                                     last_sync_by  = sy-uname
                                     error_message = ls_response-mensaje
                                     ).
                <fs_doc>-menerror = ev_message.
                APPEND ls_zinv TO lt_zinv_update.
*                ev_success = abap_false.
*                ev_message = |Error de sistema/SOAP en doc { <fs_group>-inventorydocument }|.
                APPEND INITIAL LINE TO t_result ASSIGNING <fs_result>.
                <fs_result>-companycode = <fs_doc>-bukrs.
                <fs_result>-inventorydocument = <fs_doc>-inventorydocument.
                <fs_result>-inventorydocumentitem = <fs_doc>-item.
                <fs_result>-fiscalyear  = <fs_doc>-fiscalyear.
                <fs_result>-success = abap_false.
                <fs_result>-message = |Error de sistema/SOAP en doc { <fs_group>-inventorydocument }|.

*                MODIFY zinv_documentos FROM ls_zinv.
              ENDLOOP.
              "READ TABLE lt_selected_items ASSIGNING <fs_doc> WITH KEY InventoryDocument = <fs_group>-inventorydocument.
            ENDIF.
          ENDIF.
        CATCH cx_ai_system_fault INTO lo_sys_exception.
          LOOP AT lt_selected_items ASSIGNING <fs_doc> WHERE InventoryDocument = <fs_group>-inventorydocument.
            <fs_doc>-deltaid = lv_uuid.
            <fs_doc>-syncstatuscode = 'NOTSENT'.
            ls_zinv = VALUE #(
            bukrs = <fs_doc>-bukrs

                               iblnr         = <fs_group>-inventorydocument
                               gjahr         = sy-datum(4)
                               werks = <fs_doc>-plant
                               lgort = <fs_doc>-almacen
                               matnr = <fs_doc>-material
                               bldat = <fs_doc>-documentdate
                               erfmg = <fs_doc>-quantity
                               meins = <fs_doc>-baseunitofmeasure
                               zeile         =  <fs_doc>-item
                               delta_id      = lv_uuid
                               status        = 'NOTSENT'
                               last_sync_at  = lv_timestamp_iso
                               last_sync_by  = sy-uname
                               error_message = lo_sys_exception->get_text( )
                               ).
            <fs_doc>-menerror = ev_message.
*            MODIFY zinv_documentos FROM ls_zinv.
          ENDLOOP.
*          ev_success = abap_false.
*          ev_message = |Error de sistema/SOAP en doc { <fs_group>-inventorydocument }|.
          APPEND INITIAL LINE TO t_result ASSIGNING <fs_result>.
          <fs_result>-companycode = <fs_doc>-bukrs.
          <fs_result>-inventorydocument = <fs_doc>-inventorydocument.
          <fs_result>-inventorydocumentitem = <fs_doc>-item.
          <fs_result>-fiscalyear  = <fs_doc>-fiscalyear.
          <fs_result>-success = abap_false.
          <fs_result>-message = |Error de sistema/SOAP en doc { <fs_group>-inventorydocument }|.
      ENDTRY.
    ENDLOOP.
    it_selected_data = CORRESPONDING #( lt_selected_items ).
  ENDMETHOD.
ENDCLASS.
